{
  "name": "exercicio-angular",
  "version": "0.0.0",
  "scripts": {
    "ng": "ng",
    "start": "ng serve",
    "build": "ng build",
    "deploy:gh": "ng build --configuration production --base-href /exercicio-angular/ && node -e \"require('node:fs').copyFileSync('docs/index.html', 'docs/404.html')\"",
    "storybook": "ng run exercicio-angular:storybook",
    "build-storybook": "ng run exercicio-angular:build-storybook",
    "watch": "ng build --watch --configuration development",
    "test": "ng test"
  },
  "private": true,
  "overrides": {
    "webpack": "5.108.4"
  },
  "packageManager": "npm@11.4.2",
  "dependencies": {
    "@angular/common": "^22.1.2",
    "@angular/compiler": "^22.1.2",
    "@angular/core": "^22.1.2",
    "@angular/forms": "^22.1.2",
    "@angular/platform-browser": "^22.1.2",
    "@angular/platform-browser-dynamic": "22.1.2",
    "@angular/router": "^22.1.2",
    "rxjs": "~7.8.0",
    "tslib": "^2.3.0"
  },
  "devDependencies": {
    "@angular/build": "^22.1.4",
    "@angular/cli": "^22.1.4",
    "@angular/compiler-cli": "^22.1.2",
    "@compodoc/compodoc": "^2.0.0",
    "@storybook/addon-a11y": "^10.5.0",
    "@storybook/addon-docs": "^10.5.0",
    "@storybook/angular": "^10.5.0",
    "jsdom": "^28.0.0",
    "prettier": "^3.8.1",
    "storybook": "^10.5.0",
    "typescript": "~6.0.3",
    "vitest": "^4.0.8"
  }
}
